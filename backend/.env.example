# ==========================================
# 必需配置（部署时必须填写）
# ==========================================

# 数据库配置
DB_HOST=你的阿里云数据库地址
DB_PORT=5432
DB_NAME=你的数据库名
DB_USER=你的数据库用户名
DB_PASSWORD=你的数据库密码

# AI API 密钥（阿里云魔搭）
DASHSCOPE_API_KEY=你的阿里云API密钥

# JWT 密钥（生产环境请修改为随机长字符串，至少32位）
JWT_SECRET=your_jwt_secret

# 环境标识（production 会启用严格 CORS）
NODE_ENV=production

# 前端域名（配置后只允许该域名访问 API）
FRONTEND_URL=https://your-frontend.vercel.app
